# Production Environment Variables
# Copy this file to .env and update values

# Domain Configuration
DOMAIN=links.yourdomain.com

# Database Configuration (Required)
POSTGRES_PASSWORD=change_this_to_secure_random_password

# GitHub Integration (Optional)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Sync Settings
SYNC_INTERVAL_MINUTES=30

# Application Settings
NODE_ENV=production
PORT=3000

# API Authentication (REQUIRED for all non-health endpoints)
# Generate with: openssl rand -hex 32
# Must match between backend (LINK_MANAGER_API_KEY) and frontend (VITE_API_KEY)
LINK_MANAGER_API_KEY=replace-with-256-bit-random
VITE_API_KEY=replace-with-256-bit-random

# Remote MCP: Cloudflare Access Managed OAuth (all compatible MCP clients)
# Dedicated Access app: owner-only Allow policy; tunnel only ^/mcp/?$ to backend.
# Missing/invalid OAuth configuration fails startup; no legacy key fallback.
LINK_MANAGER_MCP_AUTH_MODE=cloudflare-access
LINK_MANAGER_MCP_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
LINK_MANAGER_MCP_ACCESS_AUDIENCE=your-dedicated-access-application-aud
LINK_MANAGER_MCP_OWNER_EMAIL=owner@example.com
# Optional exact HTTPS browser origins, comma-separated. Native clients omit Origin.
LINK_MANAGER_MCP_ALLOWED_ORIGINS=
# For explicitly chosen private legacy deployments only: mode=legacy-key and
# a separate random key. Remove all three Access identity settings in that mode.
LINK_MANAGER_MCP_KEY=
